# CoDD プロジェクト設定
version: "0.1.0"
codd_required_version: null
codd_required_version_strict: false

project:
  name: "{{project_name}}"
  language: "{{language}}"
  frameworks: []

# Reasoning effort is deliberately NOT `max` by default. CoDD's generate /
# implement stages run long, noisy, tool-driven contexts — the regime where a
# larger reasoning budget is not a strict upgrade (accuracy can DECREASE with
# more test-time compute on distractor-heavy tasks, and lower "overthinking"
# correlates with better agentic outcomes). Raise it to `max` per invocation
# for a narrow, closed problem, not as the standing default.
ai_command: "claude --print --permission-mode bypassPermissions --dangerously-skip-permissions --model claude-opus-4-8 --effort xhigh --tools \"\""

