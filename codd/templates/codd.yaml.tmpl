# requirement_reconciliation (optional — requirement text <-> declared operations).
# Advisory only. It reconciles requirement UNITS (Markdown table rows under the
# discovered requirement documents) against the operations declared in
# `operation_flow`, and reports units anchored to nothing.
#
# ⚠ docs/requirements/ is CANON. Discovery rglobs `docs/requirements/**/*.md`,
#   so a second copy of the same document placed beneath it (an `original/` or
#   `reference/` folder) DOUBLES every unit with no warning. Keep reference
#   material outside — e.g. docs/source/ — or list the canonical files
#   explicitly in `docs:` below.
#
# requirement_reconciliation:
#   enabled: true
#   docs:                        # optional: files or dirs; overrides discovery
#     - "docs/requirements/requirements.md"
#   sections:                    # heading substrings whose tables are in scope
#     - "機能要件"
#     - "Functional Requirements"
#   out_of_scope_markers:        # replaces the built-in marker list when set
#     - "out of scope"
#     - "対象外"
#   max_unit_warnings: 20

scan:
  source_dirs:
{{source_dirs}}
  test_dirs:
{{test_dirs}}
  doc_dirs:
{{doc_dirs}}
  config_files: []
  exclude:
    - "**/node_modules/**"
    - "**/__pycache__/**"
    - "**/dist/**"
    # Reference material: received customer specs, vendored upstream docs, past
    # versions. This is FOREIGN text — it will never carry CoDD frontmatter, and
    # it must not be counted as requirements. Keeping it here (rather than under
    # docs/requirements/) is what stops the silent double-counting described
    # above; excluding it is what stops the pre-commit hook rejecting it for
    # missing frontmatter.
    - "docs/source/**"

graph:
  store: "jsonl"
  path: "{{graph_path}}"

bands:
  green:
    min_confidence: 0.90
    min_evidence_count: 2
  amber:
    min_confidence: 0.50

propagation:
  max_depth: 10
  stop_at_contract_boundary: true

typecheck:
  enabled: false
  command: null
  max_repair_attempts: 3

# verify:
#   verification_timeout:
#     per_node_seconds: 60    # optional: hard cap for each verification_test node
#     total_seconds: 300      # optional: total budget for all verification_test nodes

ci:
  provider: github_actions   # github_actions | gitlab_ci | none
  # GitHub Actions loads BOTH .yml and .yaml; the default spans both (comma-
  # separated union). Narrow to a single pattern to scope to one extension.
  workflow_glob: .github/workflows/*.yml,.github/workflows/*.yaml
  required_triggers:
    - push
    - pull_request
  runtime_check: false       # opt-in (v2.13.0)
  staleness_days: 14
  default_branch: main

